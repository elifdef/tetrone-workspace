# Global
APP_NAME="Tetrone"
APP_ENV=local
APP_DEBUG=true
APP_KEY=

APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
ASSET_URL=/

# URL frontend (Vite)
VITE_API_URL=/v1
VITE_WS_URL=http://localhost:3000

# Constants
MICROSERVICE_KEY=
MAX_FILE_SIZE_KB=20480
ALLOW_REGISTRATION=true
NEED_CONFIRM_EMAIL=true

# DB
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=laravel_events

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# Elasticsearch
SCOUT_DRIVER=elastic
ELASTIC_HOST=http://elasticsearch:9200
SCOUT_QUEUE=false

# Websocket
WS_PORT=3000
LARAVEL_API_URL=http://backend:8000/v1
BROADCAST_CONNECTION=log
BROADCAST_DRIVER=stream

# Mail
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@tetrone.com"
MAIL_FROM_NAME="${APP_NAME}"

# File system
FILESYSTEM_DISK=public
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null